{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/contracts/policy-template-v1.schema.json",
  "title": "IICP Management Policy Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "revision_id", "title", "description", "provenance", "compatibility_profile", "authorizes_activation", "parameters", "constraints"],
  "properties": {
    "schema_version": {"const": "iicp.management-policy-template.v1"},
    "template_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "provenance": {"type": "string", "minLength": 1},
    "compatibility_profile": {"type": "string", "minLength": 1},
    "authorizes_activation": {"const": false},
    "parameters": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/parameter"}},
    "constraints": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/constraint"}}
  },
  "$defs": {
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter_id", "value_type", "required", "allowed_values"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["string", "boolean", "number", "string_array"]},
        "required": {"type": "boolean"},
        "default": {},
        "allowed_values": {"type": "array"}
      }
    },
    "expected": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["source", "value"], "properties": {"source": {"const": "literal"}, "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "parameter_id"], "properties": {"source": {"const": "parameter"}, "parameter_id": {"type": "string", "minLength": 1}}}
      ]
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "fact", "operator", "expected"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "fact": {"type": "string", "minLength": 1},
        "operator": {"enum": ["eq", "in", "contains", "lte"]},
        "expected": {"$ref": "#/$defs/expected"}
      }
    }
  }
}
