{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iicp.network/schemas/management-contract-v1.schema.json",
  "title": "IICP management contract v1",
  "oneOf": [
    {"$ref": "#/$defs/desiredStateBundle"},
    {"$ref": "#/$defs/acceptedState"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/observation"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/policyResult"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|absent)$"},
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"enum": ["OPTIONAL_IGNORABLE", "OPTIONAL_NEGOTIABLE", "REQUIRED_UNDERSTOOD", "REQUIRED_SECURITY_CRITICAL"]}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "kind", "desired"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "desired": {"type": "object"},
        "secret_refs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "desiredStateBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "bundle_id", "issuer", "audience", "expected_generation", "resources"],
      "properties": {
        "schema_version": {"const": "1"},
        "bundle_id": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "expected_generation": {"type": "integer", "minimum": 0},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "extensions": {"type": "array", "items": {"$ref": "#/$defs/extension"}}
      }
    },
    "acceptedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "resource_digests"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "resource_digests": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "resource_id", "action", "before_digest", "after_digest", "expected_generation", "target_generation", "idempotency_key"],
      "properties": {
        "operation_id": {"type": "string"}, "resource_id": {"type": "string"},
        "action": {"enum": ["create", "update", "delete", "verify"]},
        "before_digest": {"$ref": "#/$defs/digest"}, "after_digest": {"$ref": "#/$defs/digest"},
        "expected_generation": {"type": "integer", "minimum": 0}, "target_generation": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "minLength": 1}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "planner_version", "bundle_id", "bundle_digest", "expected_generation", "target_generation", "operations"],
      "properties": {
        "schema_version": {"const": "1"}, "planner_version": {"type": "string"}, "bundle_id": {"type": "string"},
        "bundle_digest": {"$ref": "#/$defs/digest"}, "expected_generation": {"type": "integer"}, "target_generation": {"type": "integer"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "approval_id", "audience", "bundle_digest", "plan_digest", "expected_generation"],
      "properties": {
        "schema_version": {"const": "1"}, "approval_id": {"type": "string"}, "audience": {"type": "string"},
        "bundle_digest": {"$ref": "#/$defs/digest"}, "plan_digest": {"$ref": "#/$defs/digest"}, "expected_generation": {"type": "integer"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "resource_id", "observed_generation", "observed_digest", "state"],
      "properties": {
        "schema_version": {"const": "1"}, "resource_id": {"type": "string"}, "observed_generation": {"type": "integer"},
        "observed_digest": {"$ref": "#/$defs/digest"}, "state": {"enum": ["converged", "partially_converged", "failed"]}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "audience", "bundle_digest", "plan_digest", "accepted_generation", "effective_state", "observations"],
      "properties": {
        "schema_version": {"const": "1"}, "receipt_id": {"type": "string"}, "audience": {"type": "string"},
        "bundle_digest": {"$ref": "#/$defs/digest"}, "plan_digest": {"$ref": "#/$defs/digest"}, "accepted_generation": {"type": "integer"},
        "effective_state": {"enum": ["converged", "partially_converged", "failed"]},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason_codes", "input_digest", "policy_digest", "evaluator_profile"],
      "properties": {
        "decision": {"enum": ["allow", "deny", "indeterminate"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^IICP-POLICY-[A-Z-]+$"}
        },
        "input_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "evaluator_profile": {"const": "iicp.management-policy.typed-v0"}
      }
    }
  }
}
