{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iicp.network/contracts/management-reconciliation-v1.schema.json",
  "title":"IICP bounded drift and reconciliation v1",
  "oneOf":[{"$ref":"#/$defs/assessment"},{"$ref":"#/$defs/status"},{"$ref":"#/$defs/proposal"}],
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-fA-F]{64}$"},
    "class":{"enum":["unclassified","safe_metadata","capability_runtime","membership","trust_identity","secret_reference","irreversible_divergence"]},
    "assessment":{"type":"object","additionalProperties":false,"required":["schema_version","assessment_id","run_id","manifest_digest","target_id","expected_digest","expected_generation","state","drift_class","evidence_source","observed_at","expires_at","reason","authorizes_mutation"],"properties":{"schema_version":{"const":"iicp.management-drift-assessment.v1"},"assessment_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"manifest_digest":{"$ref":"#/$defs/digest"},"target_id":{"type":"string","minLength":1},"expected_digest":{"$ref":"#/$defs/digest"},"expected_generation":{"type":"integer","minimum":0},"observed_digest":{"$ref":"#/$defs/digest"},"observed_generation":{"type":"integer","minimum":0},"state":{"enum":["in_sync","drifted","unknown"]},"drift_class":{"$ref":"#/$defs/class"},"evidence_source":{"type":"string","minLength":1},"observed_at":{"type":"integer","minimum":0},"expires_at":{"type":"integer","minimum":0},"reason":{"type":"string","minLength":1},"authorizes_mutation":{"const":false}}},
    "status":{"type":"object","additionalProperties":false,"required":["schema_version","run_id","manifest_digest","authorizes_mutation","assessments"],"properties":{"schema_version":{"const":"iicp.management-drift-assessment.v1"},"run_id":{"type":"string"},"manifest_digest":{"$ref":"#/$defs/digest"},"authorizes_mutation":{"const":false},"assessments":{"type":"array","items":{"$ref":"#/$defs/assessment"}}}},
    "proposal":{"type":"object","additionalProperties":false,"required":["schema_version","proposal_id","run_id","target_id","assessment_digest","drift_class","desired_digest","expected_observed_generation","related_operation_id","created_at","expires_at","requires_fresh_apply_gate","authorizes_mutation"],"properties":{"schema_version":{"const":"iicp.management-reconciliation-proposal.v1"},"proposal_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"target_id":{"type":"string","minLength":1},"assessment_digest":{"$ref":"#/$defs/digest"},"drift_class":{"enum":["safe_metadata","capability_runtime"]},"desired_digest":{"$ref":"#/$defs/digest"},"expected_observed_generation":{"type":"integer","minimum":0},"related_operation_id":{"type":"string","minLength":1},"created_at":{"type":"integer","minimum":0},"expires_at":{"type":"integer","minimum":0},"requires_fresh_apply_gate":{"const":true},"authorizes_mutation":{"const":false}}}
  }
}
